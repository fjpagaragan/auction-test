{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node ./dist/src/start-server.js",
    "start:dev": "export NODE_ENV=local && nodemon --inspect=5858 -e ts,tsx,yml --exec node -r ts-node/register ./src/start-server.ts",
    "start:docker": "export NODE_ENV=local && nodemon --inspect=5858 -e ts,tsx,yml --exec node -r ts-node/register ./src/start-server.ts",
    "migrate": "docker exec -it backend npx sequelize-cli db:migrate",
    "migrate:undo": "docker exec -it backend npx sequelize-cli db:migrate:undo",
    "migrate:down": "docker exec -it backend npx sequelize-cli db:migrate:undo:all",
    "seed": "docker exec -it backend npx sequelize-cli db:seed:all",
    "seed:down": "docker exec -it backend npx sequelize-cli db:seed:undo:all",
    "migrate:seed:up": "npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "lint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "docker:local": "docker compose -f ../docker-compose.yml up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "1.2.2",
    "bcryptjs": "^2.4.3",
    "cls-hooked": "^4.2.2",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "6.14.0",
    "guid-typescript": "1.0.9",
    "helmet": "4.6.0",
    "http-errors": "2.0.0",
    "http-status-codes": "2.1.4",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "morgan": "1.10.0",
    "pg": "8.7.3",
    "pg-hstore": "2.3.4",
    "sequelize": "6.29.1",
    "sequelize-cli": "^6.5.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.0",
    "uuid": "8.3.2",
    "winston": "3.5.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cls-hooked": "^4.3.3",
    "@types/compression": "1.7.2",
    "@types/cors": "2.8.12",
    "@types/express": "4.17.13",
    "@types/http-errors": "1.8.2",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/lodash": "^4.14.191",
    "@types/morgan": "1.9.3",
    "@types/node": "^14.18.9",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "8.3.4",
    "@types/validator": "13.7.2",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "5.10.1",
    "copyfiles": "2.4.1",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "node-mocks-http": "^1.11.0",
    "nodemon": "2.0.16",
