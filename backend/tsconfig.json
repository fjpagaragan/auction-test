{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["es2019"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@databaseConfig": ["config/config.js"],
      "*": ["node_modules/*"],
    },
    "typeRoots": ["./src/types", "node_modules/@types"],
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  }
}
